STEP 9 — VIEWS
View 1: vw_product_price
CREATE OR REPLACE VIEW vw_product_price AS SELECT
    p.PRODUCT_ID,
    p.PRODUCT_NAME,     pp.PRODUCT_PRICE_ID,     pp.PRODUCT_PRICE_PRICE,
    pp.PRODUCT_PRICE_EFF_DATE                                    AS START_DATE,     LEAD(pp.PRODUCT_PRICE_EFF_DATE)
        OVER (PARTITION BY pp.PRODUCT_PRICE_PRODUCT_ID               ORDER BY pp.PRODUCT_PRICE_EFF_DATE)                AS END_DATE
FROM PRODUCT p
JOIN PRODUCT_PRICE pp ON p.PRODUCT_ID = pp.PRODUCT_PRICE_PRODUCT_ID;
View 2: vw_product_max_price_increase
CREATE OR REPLACE VIEW vw_product_max_price_increase AS WITH price_with_prev AS (     SELECT
        pp.PRODUCT_PRICE_PRODUCT_ID   AS PRODUCT_ID,
        p.PRODUCT_NAME,         pp.PRODUCT_PRICE_ID,         pp.PRODUCT_PRICE_PRICE,         LAG(pp.PRODUCT_PRICE_PRICE)
            OVER (PARTITION BY pp.PRODUCT_PRICE_PRODUCT_ID                   ORDER BY pp.PRODUCT_PRICE_EFF_DATE)            AS PREV_PRICE
    FROM PRODUCT_PRICE pp     JOIN PRODUCT p ON pp.PRODUCT_PRICE_PRODUCT_ID = p.PRODUCT_ID ),
price_increases AS (     SELECT
        PRODUCT_ID, PRODUCT_NAME, PRODUCT_PRICE_ID,         ROUND(((PRODUCT_PRICE_PRICE - PREV_PRICE) / PREV_PRICE) * 100, 2) AS PCT_INCREASE
    FROM price_with_prev     WHERE PREV_PRICE IS NOT NULL AND PRODUCT_PRICE_PRICE > PREV_PRICE
) SELECT PRODUCT_ID, PRODUCT_NAME, PRODUCT_PRICE_ID, PCT_INCREASE
FROM price_increases
WHERE PCT_INCREASE = (SELECT MAX(PCT_INCREASE) FROM price_increases);
