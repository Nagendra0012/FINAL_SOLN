Database Systems Final Exam Project

STEP 1 — CREATE 12 TABLES
CREATE TABLE ZIP (
    ZIPCODE     VARCHAR2(10) NOT NULL,
    CITY        VARCHAR2(100),     STATE_ABBR  VARCHAR2(2),     CONSTRAINT PK_ZIP PRIMARY KEY (ZIPCODE)
);
CREATE TABLE ADDRESS (
    ADDRESS_ID       RAW(16) NOT NULL,     ADDRESS_LINE1    VARCHAR2(200),     ADDRESS_LINE2    VARCHAR2(200),
    ADDRESS_CITY     VARCHAR2(100),     ADDRESS_STATE    VARCHAR2(2),
    ADDRESS_ZIPCODE  VARCHAR2(10),     CONSTRAINT PK_ADDRESS PRIMARY KEY (ADDRESS_ID)
);
CREATE TABLE CUSTOMER (
    CUSTOMER_ID          RAW(16) NOT NULL,     CUSTOMER_FIRST_NAME  VARCHAR2(100),     CUSTOMER_LAST_NAME   VARCHAR2(100),     CUSTOMER_EMAIL       VARCHAR2(200),     CONSTRAINT PK_CUSTOMER PRIMARY KEY (CUSTOMER_ID) );
CREATE TABLE CUSTOMER_ADDRESS (
    CUSTOMER_ADDRESS_ID          RAW(16) NOT NULL,     CUSTOMER_ADDRESS_CUSTOMER_ID RAW(16),     CUSTOMER_ADDRESS_ADDRESS_ID  RAW(16),
    CUSTOMER_ADDRESS_ACTV_IND    VARCHAR2(1),     CUSTOMER_ADDRESS_DFLT        VARCHAR2(1),     CONSTRAINT PK_CUSTOMER_ADDRESS PRIMARY KEY (CUSTOMER_ADDRESS_ID) );
CREATE TABLE ORDER_STATUS (
    ORDER_STATUS_ID RAW(16) NOT NULL,     STATUS_NAME     VARCHAR2(50),     CONSTRAINT PK_ORDER_STATUS PRIMARY KEY (ORDER_STATUS_ID) );
CREATE TABLE ORDERS (
    ORDER_ID        RAW(16) NOT NULL,     CUSTOMER_ID     RAW(16),
    ORDER_STATUS_ID RAW(16),     ORDER_DATE      DATE,     CONSTRAINT PK_ORDERS PRIMARY KEY (ORDER_ID) );
CREATE TABLE PRODUCT (
    PRODUCT_ID   RAW(16) NOT NULL,     PRODUCT_NAME VARCHAR2(200),     CONSTRAINT PK_PRODUCT PRIMARY KEY (PRODUCT_ID) );
CREATE TABLE PRODUCT_PRICE (
    PRODUCT_PRICE_ID         RAW(16) NOT NULL,     PRODUCT_PRICE_PRODUCT_ID RAW(16),
    PRODUCT_PRICE_PRICE      NUMBER(10,2),     PRODUCT_PRICE_EFF_DATE   DATE,     CONSTRAINT PK_PRODUCT_PRICE PRIMARY KEY (PRODUCT_PRICE_ID) );
CREATE TABLE ORDER_ITEM (
    ORDER_ITEM_ID    RAW(16) NOT NULL,     ORDER_ID         RAW(16),
    PRODUCT_PRICE_ID RAW(16),     QUANTITY         NUMBER,     CONSTRAINT PK_ORDER_ITEM PRIMARY KEY (ORDER_ITEM_ID) );
CREATE TABLE SHIPMENT (
    SHIPMENT_ID         RAW(16) NOT NULL,     SHIPMENT_ORDERS_ID  RAW(16),
    SHIPMENT_ADDRESS_ID RAW(16),     SHIPMENT_DATE       DATE,     CONSTRAINT PK_SHIPMENT PRIMARY KEY (SHIPMENT_ID) );
CREATE TABLE PAYMENT (
    PAYMENT_ID        RAW(16) NOT NULL,     PAYMENT_ORDERS_ID RAW(16),
    PAYMENT_AMOUNT    NUMBER(10,2),     PAYMENT_DATE      DATE,
    PAYMENT_METHOD    VARCHAR2(50),     CONSTRAINT PK_PAYMENT PRIMARY KEY (PAYMENT_ID) );
CREATE TABLE PRODUCT_CATEGORY (
    PRODUCT_CATEGORY_ID   RAW(16) NOT NULL,     PRODUCT_CATEGORY_NAME VARCHAR2(100),     CONSTRAINT PK_PRODUCT_CATEGORY PRIMARY KEY (PRODUCT_CATEGORY_ID) );
